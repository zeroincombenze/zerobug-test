<odoo>

    <record id="context_help_page_tree" model="ir.ui.view">
        <field name="name">context.help.page.tree</field>
        <field name="model">context.help.page</field>
        <field name="arch" type="xml">
            <tree>
                <field name="key"/>
                <field name="lang"/>
                <field name="name"/>
                <field name="module"/>
                <field name="model"/>
                <field name="view_type"/>
                <field name="edited"/>
                <field name="source_changed"/>
            </tree>
        </field>
    </record>

    <record id="context_help_page_form" model="ir.ui.view">
        <field name="name">context.help.page.form</field>
        <field name="model">context.help.page</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open" class="oe_highlight"/>
                    <button name="action_reset_to_source" type="object" string="Reset to source"
                        attrs="{'invisible': [('edited', '=', False)]}"
                        confirm="Discard the changes made to this page?"/>
                    <button name="action_source_seen" type="object" string="Keep my version"
                        attrs="{'invisible': [('source_changed', '=', False)]}"/>
                    <button name="action_rebuild" type="object" string="Rebuild all pages"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                        attrs="{'invisible': [('source_changed', '=', False)]}">
                        The source of this page changed after it was edited:
                        reset to source or keep your version.
                    </div>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="name"/>
                            <field name="lang"/>
                            <field name="module"/>
                            <field name="source_file"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="view_xmlid"/>
                            <field name="view_type"/>
                            <field name="edited"/>
                            <field name="source_changed"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="content" string="Content">
                            <field name="html"/>
                        </page>
                        <page name="source" string="Source">
                            <field name="source_html"/>
                        </page>
                        <page name="sections" string="Sections">
                            <field name="section_ids">
                                <tree>
                                    <field name="label"/>
                                    <field name="title"/>
                                    <field name="question"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="context_help_page_search" model="ir.ui.view">
        <field name="name">context.help.page.search</field>
        <field name="model">context.help.page</field>
        <field name="arch" type="xml">
            <search>
                <field name="key"/>
                <field name="name"/>
                <field name="model"/>
                <field name="module"/>
                <filter name="edited" string="Edited" domain="[('edited', '=', True)]"/>
                <filter name="source_changed" string="Source changed"
                    domain="[('source_changed', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_module" string="Module" context="{'group_by': 'module'}"/>
                    <filter name="group_lang" string="Language" context="{'group_by': 'lang'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="context_help_question_tree" model="ir.ui.view">
        <field name="name">context.help.question.tree</field>
        <field name="model">context.help.question</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="question"/>
                <field name="model"/>
                <field name="page_key"/>
                <field name="found"/>
                <field name="answer_page_id"/>
                <field name="provider"/>
            </tree>
        </field>
    </record>

    <record id="context_help_question_search" model="ir.ui.view">
        <field name="name">context.help.question.search</field>
        <field name="model">context.help.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="question"/>
                <field name="model"/>
                <field name="user_id"/>
                <filter name="not_found" string="Unanswered" domain="[('found', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_context_help_page" model="ir.actions.act_window">
        <field name="name">Help Pages</field>
        <field name="res_model">context.help.page</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_context_help_question" model="ir.actions.act_window">
        <field name="name">Help Questions</field>
        <field name="res_model">context.help.question</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_context_help" name="Context Help"
        parent="base.menu_custom" sequence="90"/>
    <menuitem id="menu_context_help_page" action="action_context_help_page"
        parent="menu_context_help" sequence="10"/>
    <menuitem id="menu_context_help_question" action="action_context_help_question"
        parent="menu_context_help" sequence="20"/>

</odoo>
