<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="table_wco_tree">
        <field name="name">Midea table with company (tree)</field>
        <field name="model">midea.table_wco</field>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <list string="Midea tree">
                <field name="name"/>
                <field name="date"/>
                <field name="active"/>
                <field name="state"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="table_wco_form">
        <field name="name">Midea table with company (form)</field>
        <field name="model">midea.table_wco</field>
        <field name="type">form</field>
        <field name="priority" eval="16"/>
        <field name="arch" type="xml">
            <form string="Midea form">
                <header>
                    <button name="action_draft" string="Draft" type="object" invisible="state == 'draft'"/>
                    <button name="action_done" string="Confirm" type="object" invisible="state == 'done'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" invisible="not active"/>
                </header>
                <group>
                    <field name="image" widget="image" class="oe_avatar" invisible="state == 'cancel'"/>
                    <field name="name"/>
                    <field name="rank"/>
                    <field name="currency_id" readonly="state == 'done'"/>
                    <field name="amount" readonly="state == 'done'"/>
                    <field name="date"/>
                    <field name="active"/>
                    <field name="company_id"/>
                </group>
                <group>
                    <field name="partner_ids" widget="many2many_tags"/>
                </group>
                <group>
                    <field name="description"/>
                </group>
            </form>
        </field>
    </record>

    <record id="midea.action_test_wco" model="ir.actions.act_window">
        <field name="name">My idea test record</field>
        <field name="res_model">midea.table_wco</field>
        <field name="view_id" ref="midea.table_wco_tree"/>
    </record>

</odoo>
